<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- 顶部：地址栏（Via 极简风格） -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_toolbar"
        android:elevation="2dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <!-- 后退 -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="@color/text_secondary" />

        <!-- 前进 -->
        <ImageButton
            android:id="@+id/btn_forward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/forward"
            android:src="@drawable/ic_forward"
            android:tint="@color/text_secondary" />

        <!-- 地址栏 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_address_bar_flat"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <!-- HTTPS 锁图标 -->
            <ImageView
                android:id="@+id/btn_lock"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="连接安全"
                android:src="@drawable/ic_lock"
                android:tint="@color/qiyun_blue"
                android:visibility="gone" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp"
                android:padding="0dp"
                android:paddingStart="6dp" />

            <!-- 清除按钮 -->
            <ImageView
                android:id="@+id/btn_clear"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="清除"
                android:src="@drawable/ic_close"
                android:tint="@color/text_tertiary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 刷新 -->
        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/refresh"
            android:src="@drawable/ic_refresh"
            android:tint="@color/text_secondary" />

        <!-- 更多菜单 -->
        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_settings"
            android:src="@drawable/ic_more"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- 页面容器：显示当前标签页 -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 底部工具栏：Via 风格（主页/后退/前进/标签/更多） -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_toolbar"
        android:elevation="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- 主页 -->
        <LinearLayout
            android:id="@+id/bottom_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/home"
                android:src="@drawable/ic_home"
                android:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home"
                android:textSize="10sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- 后退 -->
        <LinearLayout
            android:id="@+id/bottom_back"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back"
                android:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                android:textSize="10sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- 前进 -->
        <LinearLayout
            android:id="@+id/bottom_forward"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/forward"
                android:src="@drawable/ic_forward"
                android:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forward"
                android:textSize="10sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- 标签页（显示数量） -->
        <LinearLayout
            android:id="@+id/bottom_tabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/menu_new_tab"
                android:src="@drawable/ic_tabs"
                android:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/bottom_tabs_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="10sp"
                android:textColor="@color/qiyun_blue" />
        </LinearLayout>

        <!-- 菜单/更多 -->
        <LinearLayout
            android:id="@+id/bottom_more"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/menu_settings"
                android:src="@drawable/ic_more"
                android:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_settings"
                android:textSize="10sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 无痕模式提示条 -->
    <LinearLayout
        android:id="@+id/incognitoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#263238"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/menu_incognito"
            android:src="@drawable/ic_incognito"
            android:tint="#80CBC4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/incognito_hint"
            android:textColor="#ECEFF1"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
